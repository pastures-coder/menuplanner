{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "menuplanner",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
